<header class="fixed top-0 inset-x-0 z-40 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
  <div class="h-14 px-4 flex items-center justify-between">
    <span class="text-headline text-on-surface tracking-tight truncate"><%= content_for(:title) %></span>

    <%= link_to profile_path, class: "w-11 h-11 flex items-center justify-center shrink-0" do %>
      <% if Current.user.avatar.attached? && Current.user.avatar.attachment.persisted? %>
        <%= image_tag Current.user.avatar, class: "w-8 h-8 rounded-full object-cover" %>
      <% else %>
        <span class="material-symbols-outlined text-on-surface-variant">account_circle</span>
      <% end %>
    <% end %>
  </div>
</header>
