<% content_for :title, "Entrar" %>

<div class="max-w-sm mx-auto mt-8 bg-surface-container-lowest rounded-2xl shadow-sm p-8">
  <h1 class="text-large-title text-on-surface mb-6">Entrar</h1>

  <%= form_with url: session_path do |form| %>
    <div class="bg-surface-container rounded-2xl mb-6 overflow-hidden">
      <%= render "shared/form_row", form: form, attribute: :email_address, label: "Email", type: :email, options: { required: true, autofocus: true } %>
      <%= render "shared/form_row", form: form, attribute: :password, label: "Senha", type: :password, options: { required: true, autocomplete: "current-password" }, last: true %>
    </div>

    <%= form.submit "Entrar", class: "w-full bg-primary text-on-primary rounded-full px-5 py-3 text-headline shadow-sm active:bg-primary-container active:scale-[0.98] transition-all duration-150 cursor-pointer" %>
  <% end %>

  <%= button_to "Entrar com Apple", "/auth/apple", data: { turbo: false }, class: "mt-4 w-full bg-on-surface text-surface rounded-full px-5 py-3 text-headline shadow-sm active:opacity-80 active:scale-[0.98] transition-all duration-150 cursor-pointer" %>

  <p class="mt-4 text-footnote flex gap-2">
    <%= render "shared/link_action", text: "Criar conta", url: new_registration_path %> ·
    <%= render "shared/link_action", text: "Esqueci minha senha", url: new_password_path %>
  </p>
</div>
