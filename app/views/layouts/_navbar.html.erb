<nav class="fixed bottom-0 inset-x-0 z-40 pb-safe bg-surface/85 backdrop-blur-xl shadow-[0_-2px_12px_rgba(0,0,0,0.04)]">
  <div class="flex justify-around items-center h-16 px-2">
    <% {
         "Início" => [root_path, "home"],
         "Calendário" => [calendar_path, "calendar_month"],
         "Profile" => [profile_path, "account_circle"],
       }.each do |label, (path, icon)| %>
      <% active = current_page?(path) %>
      <%= link_to path, class: "flex flex-col items-center justify-center flex-1 h-11 transition-colors #{active ? "text-primary" : "text-on-surface-variant"}" do %>
        <span class="material-symbols-outlined text-[24px] mb-0.5"><%= icon %></span>
        <span class="text-caption-2 <%= "font-semibold" if active %>"><%= label %></span>
      <% end %>
    <% end %>
  </div>
</nav>
