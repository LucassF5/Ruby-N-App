<% content_for :title, "Profile" %>

<%= native_navbar_tag("Profile") do |navbar| %>
  <% navbar.button icons: { ios: "pencil", android: "edit" }, href: edit_profile_path %>
<% end %>

<h1 class="text-large-title text-on-surface mb-6 native-hidden">Profile</h1>

<div class="bg-surface-container-lowest rounded-2xl shadow-sm p-5 mb-6 flex items-center gap-4">
  <% if @user.avatar.attached? && @user.avatar.attachment.persisted? %>
    <%= image_tag @user.avatar, class: "w-16 h-16 rounded-full object-cover" %>
  <% else %>
    <span class="material-symbols-outlined text-outline-variant text-[48px]">account_circle</span>
  <% end %>
  <div>
    <p class="text-headline text-on-surface"><%= @user.name %></p>
    <p class="text-subheadline text-on-surface-variant"><%= @user.email_address %></p>
  </div>
</div>

<div class="max-w-sm space-y-3 native-hidden">
  <%= render "shared/link_action", text: "Editar perfil", url: edit_profile_path %>
  <%= render "shared/link_action", text: "Sair", url: session_path, method: :delete, variant: :neutral %>
</div>
