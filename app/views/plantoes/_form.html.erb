<%= form_with model: plantao, class: "bg-white border border-slate-200 rounded-lg p-4 mb-8 flex flex-col gap-3" do |f| %>
  <% if plantao.errors.any? %>
    <ul class="text-red-600 text-sm">
      <% plantao.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= f.label :data, "Data", class: "text-sm font-medium" %>
  <%= f.date_field :data, class: "border border-slate-300 rounded px-3 py-2" %>

  <%= f.label :hora_inicio, "Horário de início", class: "text-sm font-medium" %>
  <%= f.time_field :hora_inicio, class: "border border-slate-300 rounded px-3 py-2" %>

  <%= f.label :hora_fim, "Horário de término", class: "text-sm font-medium" %>
  <%= f.time_field :hora_fim, class: "border border-slate-300 rounded px-3 py-2" %>

  <%= f.label :local, "Local (opcional)", class: "text-sm font-medium" %>
  <%= f.text_field :local, class: "border border-slate-300 rounded px-3 py-2" %>

  <%= f.label :observacao, "Observação (opcional)", class: "text-sm font-medium" %>
  <%= f.text_area :observacao, rows: 3, class: "border border-slate-300 rounded px-3 py-2" %>

  <%= f.submit "Salvar", class: "self-start bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 cursor-pointer" %>
<% end %>
