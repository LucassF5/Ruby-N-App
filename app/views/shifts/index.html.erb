<% content_for :title, "Meus Plantões" %>

<%= native_navbar_tag("Meus Plantões") do |navbar| %>
  <% navbar.button icons: { ios: "plus", android: "add" }, href: new_shift_path %>
<% end %>

<% if @shifts.empty? %>
  <p class="text-body text-on-surface-variant">Nenhum plantão cadastrado ainda.</p>
<% else %>
  <div class="flex flex-col gap-4">
    <% @shifts.each do |shift| %>
      <div class="bg-surface-container-lowest rounded-2xl shadow-sm p-4 border-l-4" style="border-left-color: <%= shift.category&.color || "#C7C4D6" %>">
        <div class="flex justify-between items-start">
          <div>
            <h2 class="text-headline text-on-surface">
              <%= l(shift.date, format: :long) %> · <%= shift.start_time.strftime("%H:%M") %>–<%= shift.end_time.strftime("%H:%M") %>
            </h2>
            <% if shift.category.present? %>
              <p class="text-subheadline text-on-surface-variant mt-1"><%= shift.category.name %></p>
            <% elsif shift.location.present? %>
              <p class="text-subheadline text-on-surface-variant mt-1"><%= shift.location %></p>
            <% end %>
            <% if shift.notes.present? %>
              <p class="text-footnote text-on-surface-variant mt-1"><%= shift.notes %></p>
            <% end %>
          </div>
          <div class="flex gap-3 shrink-0 items-center">
            <%= render "shared/link_action", text: "Editar", url: edit_shift_path(shift) %>
            <%= render "shared/button_danger", text: "Remover", url: shift_path(shift), html: { form: { data: { turbo_confirm: "Remover este plantão?" } } } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
