<% content_for :title, "Categorias" %>

<div class="flex justify-between items-center mb-4">
  <h1 class="text-title-2 text-on-surface">Categorias</h1>
  <%= render "shared/button_primary", text: "Nova categoria", url: new_category_path %>
</div>

<% if @categories.empty? %>
  <p class="text-body text-on-surface-variant">Nenhuma categoria cadastrada ainda.</p>
<% else %>
  <div class="flex flex-col gap-4">
    <% @categories.each do |category| %>
      <div class="bg-surface-container-lowest rounded-2xl shadow-sm p-4 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <span class="w-4 h-4 rounded-full shrink-0" style="background-color: <%= category.color %>"></span>
          <div>
            <h2 class="text-headline text-on-surface"><%= category.name %></h2>
            <p class="text-footnote text-on-surface-variant"><%= category.start_time.strftime("%H:%M") %>–<%= category.end_time.strftime("%H:%M") %></p>
          </div>
        </div>
        <div class="flex gap-3 shrink-0 items-center">
          <%= render "shared/link_action", text: "Editar", url: edit_category_path(category) %>
          <%= render "shared/button_danger", text: "Remover", url: category_path(category), html: { form: { data: { turbo_confirm: "Remover esta categoria?" } } } %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<div class="mt-4">
  <%= render "shared/link_action", text: "Voltar ao calendário", url: calendar_path %>
</div>
