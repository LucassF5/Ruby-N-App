<% content_for :title, "Editar Categoria" %>

<%= native_form_tag %>
<%= native_navbar_tag("Editar Categoria") do |navbar| %>
  <% navbar.submit_button %>
<% end %>

<h1 class="text-large-title text-on-surface mb-6 native-hidden">Editar Categoria</h1>

<%= render "form", category: @category %>

<%= render "shared/link_action", text: "Voltar", url: categories_path, html: { class: "native-hidden" } %>
